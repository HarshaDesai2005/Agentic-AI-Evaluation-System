# Copy to .env and adjust as needed. Never commit .env.

# Local Ollama (never point this at a cloud LLM)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_PREDICT=768

# Local embeddings (downloaded once into data/model_cache)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Retrieval
TOP_K=5
RETRIEVAL_MIN_SCORE=0.32

# Uploads
MAX_UPLOAD_MB=25

# Optional basic auth (enable if more than one local user)
AUTH_ENABLED=false
APP_USERNAME=faculty
APP_PASSWORD=change-me

# Tesseract OCR (photos and scanned/photo PDFs)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Logging
LOG_LEVEL=INFO
